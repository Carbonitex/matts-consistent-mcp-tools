<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpAtlassian</RootNamespace>
    <AssemblyName>mcp-atlassian</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Markdig" Version="0.44.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="McpAtlassian.Tests/**" />
    <None Remove="McpAtlassian.Tests/**" />
    <InternalsVisibleTo Include="McpAtlassian.Tests" />
  </ItemGroup>

</Project>
